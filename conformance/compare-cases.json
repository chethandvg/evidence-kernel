{
  "schema": "golden-vectors@1",
  "description": "Shared conformance cases for the Rust, Python and JavaScript golden-vector runners. Each case calls verdict(spec): the runner under test writes a one-case vector file from spec.case (with spec.tolerance as the file tolerance, if given), runs its check_dir against an implementation whose only function, f, returns spec.returns (or raises when spec.raises is true), and answers whether the file passed. Every runner must give the expected verdict for every case.",
  "cases": [
    {"claim": "evidence:RUNNERS-AGREE", "note": "equal integers pass", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 69}, "returns": 69}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an integer equals the same float", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 1.0}, "returns": 1}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "-0 equals 0", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 0}, "returns": -0.0}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "comparison is exact by default, so 0.1 + 0.2 is not 0.3", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 0.3}, "returns": 0.30000000000000004}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "inside the relative tolerance", "fn": "verdict", "args": [{"tolerance": {"rel": 1e-12}, "case": {"fn": "f", "args": [], "expected": 1}, "returns": 1.0000000000001}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "outside the relative tolerance", "fn": "verdict", "args": [{"tolerance": {"rel": 1e-12}, "case": {"fn": "f", "args": [], "expected": 1}, "returns": 1.000000001}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "the relative tolerance scales with |expected|, also when it is negative", "fn": "verdict", "args": [{"tolerance": {"rel": 1e-6}, "case": {"fn": "f", "args": [], "expected": -1000}, "returns": -1000.0001}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "inside the absolute tolerance", "fn": "verdict", "args": [{"tolerance": {"abs": 0.01}, "case": {"fn": "f", "args": [], "expected": 0}, "returns": 0.005}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "outside the absolute tolerance", "fn": "verdict", "args": [{"tolerance": {"abs": 0.01}, "case": {"fn": "f", "args": [], "expected": 0}, "returns": 0.02}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a relative tolerance alone passes nothing when expected is 0", "fn": "verdict", "args": [{"tolerance": {"rel": 0.5}, "case": {"fn": "f", "args": [], "expected": 0}, "returns": 1e-300}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "the larger of abs and rel * |expected| applies", "fn": "verdict", "args": [{"tolerance": {"rel": 1e-9, "abs": 0.5}, "case": {"fn": "f", "args": [], "expected": 1}, "returns": 1.4}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a case tolerance overrides the file tolerance field by field", "fn": "verdict", "args": [{"tolerance": {"rel": 0.1, "abs": 0.5}, "case": {"fn": "f", "args": [], "expected": 1, "tolerance": {"rel": 0}}, "returns": 1.4}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a case tolerance can tighten the file tolerance", "fn": "verdict", "args": [{"tolerance": {"rel": 0.1}, "case": {"fn": "f", "args": [], "expected": 1, "tolerance": {"rel": 0}}, "returns": 1.01}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "two decimal forms of the same double are equal (numbers are parsed with correct rounding)", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 1.6041656501881165}, "returns": 1.6041656501881165208800439}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "numbers are IEEE-754 doubles, so 2^53 + 1 equals 2^53", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 9007199254740993}, "returns": 9007199254740992}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "the tolerance applies inside arrays", "fn": "verdict", "args": [{"tolerance": {"rel": 1e-9}, "case": {"fn": "f", "args": [], "expected": [1, 2]}, "returns": [1.0000000001, 2]}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "the tolerance applies inside objects", "fn": "verdict", "args": [{"tolerance": {"abs": 0.1}, "case": {"fn": "f", "args": [], "expected": {"hz": 440}}, "returns": {"hz": 440.05}}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "equal strings pass", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": "A4"}, "returns": "A4"}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "strings are case sensitive", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": "A4"}, "returns": "a4"}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a number never equals its string", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": "1"}, "returns": 1}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a string never equals a number", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 1}, "returns": "1"}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "true is not 1", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 1}, "returns": true}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "1 is not true", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": true}, "returns": 1}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "false is not 0", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 0}, "returns": false}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "equal booleans pass", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": false}, "returns": false}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a tolerance never turns a boolean into a number", "fn": "verdict", "args": [{"tolerance": {"abs": 1}, "case": {"fn": "f", "args": [], "expected": 1}, "returns": true}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "null equals null", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": null}, "returns": null}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "null is not 0", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": 0}, "returns": null}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "null is not an empty object", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {}}, "returns": null}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "nested arrays and objects compare element by element", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": [1, [2, "x"], {"a": [true, null]}]}, "returns": [1, [2, "x"], {"a": [true, null]}]}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an array of a different length fails", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": [1, 2]}, "returns": [1, 2, 3]}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "array order matters", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": [1, 2]}, "returns": [2, 1]}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an array is not an object with index keys", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {"0": 1}}, "returns": [1]}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an empty array is not an empty object", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {}}, "returns": []}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an empty object is not an empty array", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": []}, "returns": {}}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "object key order does not matter", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {"midi": 69, "name": "A4"}}, "returns": {"name": "A4", "midi": 69}}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a missing key fails", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {"a": 1, "b": 2}}, "returns": {"a": 1}}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an extra key fails", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {"a": 1}}, "returns": {"a": 1, "b": 2}}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a nested difference fails", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [], "expected": {"a": {"b": [1, 2]}}}, "returns": {"a": {"b": [1, 3]}}}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an expected error passes when the function raises", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [0], "error": true}, "raises": true}], "expected": true},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an expected error fails when the function returns a value", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [0], "error": true}, "returns": 0}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an expected error fails when the function returns null", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [0], "error": true}, "returns": null}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "an unexpected error fails", "fn": "verdict", "args": [{"case": {"fn": "f", "args": [4], "expected": 0.25}, "raises": true}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a function the implementation lacks fails", "fn": "verdict", "args": [{"case": {"fn": "g", "args": [], "expected": 1}, "returns": 1}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a function the implementation lacks fails, even when an error is expected", "fn": "verdict", "args": [{"case": {"fn": "g", "args": [], "error": true}, "raises": true}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a built-in JavaScript Object member is not an implementation", "fn": "verdict", "args": [{"case": {"fn": "constructor", "args": [], "expected": {}}, "returns": {}}], "expected": false},
    {"claim": "evidence:RUNNERS-AGREE", "note": "a built-in Python dunder attribute is not an implementation", "fn": "verdict", "args": [{"case": {"fn": "__init__", "args": [], "expected": null}, "returns": null}], "expected": false}
  ]
}
