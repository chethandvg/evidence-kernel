{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chethandvg/evidence-kernel/schema/claims.schema.json",
  "title": "evidence-kernel/claims@1",
  "description": "A claims ledger: every claim a repository makes, with how it is known. P = machine-checked proof (Lean 4), V = verified numerics, T = tested, R = referenced empirical fact, M = model assumption.",
  "type": "object",
  "required": ["schema", "repo", "prefix", "claims"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "evidence-kernel/claims@1" },
    "repo": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["id", "version", "level", "statement"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Z0-9][A-Z0-9-]*$", "description": "prefix:NAME; permanent once published." },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Bump the major version whenever the statement's meaning changes." },
        "level": { "enum": ["P", "V", "T", "R", "M"] },
        "statement": { "type": "string", "minLength": 1, "description": "The claim in plain English." },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Z0-9][A-Z0-9-]*@\\d+$" },
          "description": "Claims this one relies on, as prefix:NAME@major (in this or another repo)."
        },
        "proof": { "type": "string", "pattern": "^[^#\\s]+\\.lean#[A-Za-z_][A-Za-z0-9_.']*$", "description": "path/to/File.lean#Fully.Qualified.theorem_name" },
        "check": { "type": "string", "minLength": 1, "description": "The script or test that verifies a V claim numerically." },
        "tests": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Test files or vector files that exercise the claim." },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "assumption": { "type": "string", "minLength": 1, "description": "For M claims: the assumption, stated plainly." },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "properties": {
            "value": { "type": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "unit": { "type": "string" }
          }
        },
        "species": { "type": "string" },
        "method": { "type": "string" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "level": { "const": "P" } } }, "then": { "required": ["proof"] } },
        { "if": { "properties": { "level": { "const": "V" } } }, "then": { "required": ["check"] } },
        { "if": { "properties": { "level": { "const": "T" } } }, "then": { "required": ["tests"] } },
        { "if": { "properties": { "level": { "const": "R" } } }, "then": { "required": ["sources"] } },
        { "if": { "properties": { "level": { "const": "M" } } }, "then": { "required": ["assumption"] } }
      ]
    },
    "source": {
      "type": "object",
      "required": ["cite"],
      "additionalProperties": false,
      "properties": {
        "cite": { "type": "string", "minLength": 1, "description": "Short human-readable citation, e.g. 'Taylor et al. 1993, Human Reproduction'." },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "pmid": { "type": "string", "pattern": "^\\d+$" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
