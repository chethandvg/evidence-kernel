{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chethandvg/evidence-kernel/schema/golden-vectors.schema.json",
  "title": "golden-vectors@1",
  "description": "Input/output cases that every implementation of a function (Rust, Python, WebAssembly) must reproduce.",
  "type": "object",
  "required": ["schema", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "golden-vectors@1" },
    "description": { "type": "string" },
    "tolerance": { "$ref": "#/$defs/tolerance" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fn", "args"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Z0-9][A-Z0-9-]*$" },
          "fn": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "args": { "type": "array" },
          "expected": {},
          "error": { "const": true },
          "tolerance": { "$ref": "#/$defs/tolerance" },
          "note": { "type": "string" }
        },
        "oneOf": [{ "required": ["expected"] }, { "required": ["error"] }]
      }
    }
  },
  "$defs": {
    "tolerance": {
      "description": "A number passes when |got - expected| <= max(abs, rel * |expected|). Default: exact.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rel": { "type": "number", "minimum": 0 },
        "abs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
